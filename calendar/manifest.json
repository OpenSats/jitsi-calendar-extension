{
  "manifest_version": 3,
  "name": "Jitsi Meetings (custom server)",
  "description": "Add Jitsi meeting links to Google Calendar using the OpenSats server or your own HTTPS instance.",
  "version": "0.3.1",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "jitsi-logo-16x16.png",
    "48": "jitsi-logo-48x48.png",
    "128": "jitsi-logo-128x128.png"
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/calendar/*"
      ],
      "js": [
        "jquery.js",
        "RandomUtil.js",
        "RoomnameGenerator.js",
        "server-settings.js",
        "meet-calendar.js"
      ],
      "css": [
        "/css/all.css"
      ],
      "all_frames": false,
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "resources": [
        "jitsi-logo-grey.svg",
        "jitsi-logo-white-48x48.png"
      ]
    }
  ],
  "action": {
    "default_title": "Create Jitsi Meetings",
    "default_popup": "popup.html"
  }
}
